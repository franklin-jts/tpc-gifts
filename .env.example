# Public site URL (used for canonical URLs, sitemap and structured data)
VITE_SITE_URL=https://www.thepresentationcompany.in

# Where enquiries are forwarded (CRM webhook, Zapier/Make, email service, your backend).
# Read by the /api/enquiry dev+preview middleware (plain env) — the endpoint must
# return a 2xx status for the visitor to see a success message.
ENQUIRY_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <token>" to the webhook
ENQUIRY_WEBHOOK_TOKEN=

# Fallback used ONLY when the site is deployed to static hosting (no /api route):
# the browser posts enquiries straight to the webhook (needs CORS enabled).
VITE_ENQUIRY_WEBHOOK_URL=
VITE_ENQUIRY_WEBHOOK_TOKEN=

# Optional: WhatsApp number in international format, digits only (e.g. 9198XXXXXXXX).
# Leave empty to hide the WhatsApp button.
VITE_WHATSAPP_NUMBER=
